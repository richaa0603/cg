# Environment Configuration

# AI mode: local (TypeScript domain logic + static JSON) or api (calls backend)
VITE_AI_MODE=local

# Base URL for the ASP.NET Core backend (used when VITE_AI_MODE=api)
VITE_AI_API_BASE=http://localhost:5000/api

# Gemini API key for Executive Summary AI briefing (optional)
VITE_GEMINI_API_KEY=
