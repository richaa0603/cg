{
  "manifest_version": 3,
  "name": "Consultant Copilot",
  "version": "1.0.0",
  "description": "Discover reusable knowledge and accelerate delivery inside GitHub.",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["styles.css", "panel.html", "panel.css", "panel.js"],
      "matches": ["https://github.com/*"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}