{
  "manifest_version": 3,
  "name": "Gitlas",
  "version": "1.0.0",
  "description": "Gitlas - AI-powered Enterprise Capability Discovery Platform. Discover Before You Build.",

  "action": {
    "default_title": "Gitlas - Discover Before You Build",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["gitlas-config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.css", "panel.js", "gitlas-config.js", "app/*"],
      "matches": ["https://github.com/*"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}